# VectorView config — copy from meta-bridge .env or set here
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Port to serve on
VECTORVIEW_PORT=7433

# Max points to pull per collection (PCA is O(n*dim), keep reasonable)
VECTORVIEW_MAX_POINTS=9000

# FrontPocket & MindDrill live watchers
VECTORVIEW_FRONTPOCKET_LIVE=true
VECTORVIEW_FRONTPOCKET_COLLECTIONS=frontpocket_memory,minddrill_research_thoughts,minddrill_chat_memory,fp_reflections
VECTORVIEW_FRONTPOCKET_POLL_SECONDS=3

# Semantic search: auto-detects embedding provider per collection (OpenRouter for FrontPocket 3072, Ollama for meta_bridge 768)
VECTORVIEW_SEMANTIC_PROVIDER=auto
VECTORVIEW_OPENROUTER_MODEL=google/gemini-embedding-2-preview
VECTORVIEW_EMBED_MODEL=nomic-embed-text
