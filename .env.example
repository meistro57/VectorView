# VectorView config — copy to .env and fill in your values

# Qdrant connection
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Port VectorView serves on
VECTORVIEW_PORT=7433

# Max points pulled per collection
# PCA is O(n × dim) — keep this reasonable for large collections
VECTORVIEW_MAX_POINTS=2000

# Projection cache: disk cache is always on, Redis layers on top when configured
# Example: redis://localhost:6379/0
VECTORVIEW_REDIS_URL=
VECTORVIEW_CACHE_TTL_SECONDS=600
VECTORVIEW_CACHE_DIR=.cache/projections
VECTORVIEW_CACHE_MAX_MB=512

# Projection worker concurrency (defaults to NumCPU/2) and queue wait before 429
VECTORVIEW_MAX_PROJECTIONS=4
VECTORVIEW_PROJECTION_QUEUE_SECONDS=30

# Projection worker interpreter (blank = auto-detect venv/python3) and inline Go
# PCA fallback ceiling used when the Python worker is unavailable
VECTORVIEW_PYTHON=
VECTORVIEW_INLINE_PCA_MAX=2000
# Worker PCA backend: auto | torch | cupy | numpy
VECTORVIEW_PCA_BACKEND=auto

# Exit non-zero when the startup config report has warnings
VECTORVIEW_STRICT_CONFIG=false

# Optional bearer token; when set, every /api/* request must send
# Authorization: Bearer <token> (or ?token=<token> / X-VectorView-Token)
VECTORVIEW_TOKEN=

# Live streaming + ingest integrations
# SSE heartbeat interval and default replay/throttle settings for /api/stream
VECTORVIEW_STREAM_HEARTBEAT_SECONDS=15
VECTORVIEW_STREAM_REPLAY_COUNT=0
VECTORVIEW_STREAM_MAX_EVENTS_PER_SECOND=30
# WebSocket ping interval for /api/ws keepalive
VECTORVIEW_WS_PING_SECONDS=20
# Optional live watchers for meta_bridge collections
VECTORVIEW_META_BRIDGE_LIVE=true
VECTORVIEW_META_BRIDGE_COLLECTIONS=mb_chunks,mb_claims
VECTORVIEW_META_BRIDGE_POLL_SECONDS=3

# Optional live watchers for FrontPocket / MindDrill collections
VECTORVIEW_FRONTPOCKET_LIVE=true
VECTORVIEW_FRONTPOCKET_COLLECTIONS=frontpocket_memory,minddrill_research_thoughts,minddrill_chat_memory,fp_reflections
VECTORVIEW_FRONTPOCKET_POLL_SECONDS=3

# Redis Pub/Sub telemetry channel and durable Redis Stream event log
VECTORVIEW_REDIS_PUBSUB_CHANNEL=vectorview.telemetry
VECTORVIEW_REDIS_STREAM_KEY=vectorview.events
VECTORVIEW_REDIS_STREAM_MAXLEN=20000

# Semantic search embedding provider config
# Modes: auto (detects provider & model per collection), ollama, openrouter, openai
VECTORVIEW_SEMANTIC_PROVIDER=auto

# Ollama settings (for meta_bridge / local collections)
VECTORVIEW_OLLAMA_URL=http://localhost:11434
VECTORVIEW_EMBED_MODEL=nomic-embed-text

# OpenRouter settings (for FrontPocket / MindDrill 3072-dim embeddings)
OPENROUTER_API_KEY=
VECTORVIEW_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
VECTORVIEW_OPENROUTER_MODEL=google/gemini-embedding-2-preview

# OpenAI settings (optional)
OPENAI_API_KEY=
VECTORVIEW_OPENAI_BASE_URL=https://api.openai.com/v1
VECTORVIEW_OPENAI_MODEL=text-embedding-3-small
